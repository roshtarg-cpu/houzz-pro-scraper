{
  "actorSpecification": 1,
  "name": "houzz-pro-scraper",
  "title": "Houzz Professional Scraper — Home Service Leads",
  "description": "Extract contractor, designer, and architect profiles from Houzz.com. Get contact info, ratings, reviews, and project data for B2B lead generation. Works with Claude, ChatGPT, and AI agents via Apify MCP. Zero bot protection, fast scraping, structured output.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "output": {
    "actorOutputSchemaVersion": 1,
    "properties": {
      "name": {
        "type": "string",
        "description": "Professional or business name",
        "template": "{{{name}}}"
      },
      "url": {
        "type": "string",
        "description": "Houzz profile URL",
        "template": "{{{url}}}"
      },
      "rating": {
        "type": "string",
        "description": "Average rating score",
        "template": "{{{rating}}}"
      },
      "reviewCount": {
        "type": "string",
        "description": "Number of reviews",
        "template": "{{{reviewCount}}}"
      },
      "location": {
        "type": "string",
        "description": "Business location",
        "template": "{{{location}}}"
      },
      "specialty": {
        "type": "string",
        "description": "Professional category or specialty",
        "template": "{{{specialty}}}"
      },
      "category": {
        "type": "string",
        "description": "Service category",
        "template": "{{{category}}}"
      },
      "description": {
        "type": "string",
        "description": "Business description or bio",
        "template": "{{{description}}}"
      },
      "phone": {
        "type": "string",
        "description": "Contact phone number",
        "template": "{{{phone}}}"
      },
      "website": {
        "type": "string",
        "description": "Business website URL",
        "template": "{{{website}}}"
      },
      "scrapedAt": {
        "type": "string",
        "description": "ISO 8601 timestamp of scrape",
        "template": "{{{scrapedAt}}}"
      }
    }
  }
}
